<component type="desktop-application">
  <id>io.github.anmolxlight.Satsuma</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Satsuma</name>
  <summary>Zero-click offline file converter</summary>
  <developer id="io.github.anmolxlight">
    <name>anmolxlight</name>
  </developer>
  <description>
    <p>
      Drop a file on the wheel, flick to a slice, done. Satsuma converts images, audio, video,
      PDFs, documents, slides, spreadsheets, subtitles and archives with the tools already on
      your computer. Nothing is uploaded, ever.
    </p>
    <p>Hold Shift for formats, Ctrl for file tools (compress, trim, crop, merge, split and more) and Alt for actions.</p>
  </description>
  <launchable type="desktop-id">io.github.anmolxlight.Satsuma.desktop</launchable>
